// =============================================================================
// Prisma Schema — E-Commerce Order Management Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrderStatusType {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReportType {
  SALES
  INVENTORY
  FINANCIAL
  USER_ACTIVITY
  CUSTOM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// =============================================================================
// MODELS
// =============================================================================

/// User access control role defining permission levels across the platform.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

/// Brand or manufacturer producing one or more products in the catalog.
model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

/// Product category supporting hierarchical self-referencing parent/child relationships.
model Category {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @db.VarChar(100)
  parentCategoryId String?    @map("parent_category_id") @db.Uuid
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  Category[] @relation("CategoryHierarchy")
  products         Product[]
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([parentCategoryId])
  @@map("categories")
}

/// Catalog item available for purchase, tracking baseline price and stock.
model Product {
  id            String          @id @default(uuid()) @db.Uuid
  sku           String          @unique @db.VarChar(50)
  specimenNo    String          @map("specimen_no") @db.VarChar(100)
  name          String          @db.VarChar(255)
  description   String?         @db.Text
  details       String[]
  images        String[]
  price         Decimal         @db.Decimal(12, 2)
  originalPrice Decimal?        @map("original_price") @db.Decimal(12, 2)
  sizes         String[]
  colors        Json?
  isFeatured    Boolean         @default(false) @map("is_featured")
  isNew         Boolean         @default(false) @map("is_new")
  isSale        Boolean         @default(false) @map("is_sale")
  heroSpan      String?         @map("hero_span") @db.VarChar(20)
  /// Authoritative stock figure. Locked with SELECT ... FOR UPDATE during
  /// order placement. Inventory.quantityAvailable holds the per-warehouse
  /// breakdown and is updated inside the same transaction.
  stockQty      Int             @default(0) @map("stock_qty")
  categoryId    String          @map("category_id") @db.Uuid
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId       String          @map("brand_id") @db.Uuid
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  inventories   Inventory[]
  reviews       ProductReview[]
  cartItems     Cart[]
  wishlistItems Wishlist[]
  orderItems    OrderItem[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@map("products")
}

/// Physical storage or distribution facility holding inventory.
model Warehouse {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(100)
  location    String      @db.VarChar(255)
  inventories Inventory[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("warehouses")
}

/// Stock availability mapping linking specific products to specific warehouses.
model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId       String    @map("warehouse_id") @db.Uuid
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantityAvailable Int       @default(0) @map("quantity_available")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventories")
}

/// Authentication and account identity entity for staff, admins, and customers.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at")
  roleId        String         @map("role_id") @db.Uuid
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  customer      Customer?
  notifications Notification[]
  auditLogs     AuditLog[]
  reports       Report[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

/// Profile information and domain entity for customers placing orders.
model Customer {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @unique @map("user_id") @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String          @map("first_name") @db.VarChar(100)
  lastName      String          @map("last_name") @db.VarChar(100)
  phone         String?         @db.VarChar(30)
  address       String          @db.VarChar(255)
  city          String          @db.VarChar(100)
  postalCode    String?         @map("postal_code") @db.VarChar(20)
  country       String?         @db.VarChar(100)
  orders        Order[]
  reviews       ProductReview[]
  cartItems     Cart[]
  wishlistItems Wishlist[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("customers")
}

/// Customer review and numeric rating submitted for a specific product.
model ProductReview {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
  @@map("product_reviews")
}

/// Shopping cart line items currently staged by a customer.
model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  /// Empty string rather than NULL: Postgres treats NULLs as distinct, which
  /// would let the unique constraint below be bypassed.
  selectedSize  String @default("") @map("selected_size") @db.VarChar(50)
  selectedColor String @default("") @map("selected_color") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([customerId, productId, selectedSize, selectedColor])
  @@index([customerId])
  @@index([productId])
  @@map("carts")
}

/// Saved items bookmarked by a customer for future purchase.
model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("wishlists")
}

/// System or transactional notification delivered to a user.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("notifications")
}

/// Security and compliance audit trail recording user and system actions.
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    AuditAction
  entity    String      @db.VarChar(100)
  entityId  String      @map("entity_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Analytics, sales, or inventory reports generated by authorized users.
model Report {
  id              String     @id @default(uuid()) @db.Uuid
  type            ReportType
  generatedBy     String     @map("generated_by") @db.Uuid
  generatedByUser User       @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
  generatedAt     DateTime   @default(now()) @map("generated_at")

  @@index([generatedBy])
  @@map("reports")
}

/// Historical record of database and system backup snapshots.
model BackupHistory {
  id        String       @id @default(uuid()) @db.Uuid
  fileUrl   String       @map("file_url") @db.Text
  status    BackupStatus
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("backup_histories")
}

/// Customer purchase order capturing overall status and total amount.
model Order {
  id                 String          @id @default(uuid()) @db.Uuid
  customerId         String          @map("customer_id") @db.Uuid
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount        Decimal         @map("total_amount") @db.Decimal(12, 2)
  status             OrderStatusType @default(PENDING)
  shippingName       String?         @map("shipping_name") @db.VarChar(200)
  shippingAddress    String?         @map("shipping_address") @db.VarChar(255)
  shippingCity       String?         @map("shipping_city") @db.VarChar(100)
  shippingPostalCode String?         @map("shipping_postal_code") @db.VarChar(20)
  shippingCountry    String?         @map("shipping_country") @db.VarChar(100)
  shippingPhone      String?         @map("shipping_phone") @db.VarChar(30)
  shippingMethod     String          @default("standard") @map("shipping_method") @db.VarChar(50)
  shippingCost       Decimal         @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  orderItems         OrderItem[]
  payments           Payment[]
  orderStatuses      OrderStatus[]
  invoice            Invoice?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("orders")
}

/// Line item within an order recording product, quantity, and snapshot unit price.
model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  selectedSize  String @default("") @map("selected_size") @db.VarChar(50)
  selectedColor String @default("") @map("selected_color") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Printable invoice issued once an order is confirmed.
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNo   String   @unique @map("invoice_no") @db.VarChar(50)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  issuedAt    DateTime @default(now()) @map("issued_at")

  @@map("invoices")
}

/// Payment record initiated for an order through a payment gateway.
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  gatewayTxnId String        @map("gateway_txn_id") @db.VarChar(255)
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

/// Individual payment gateway transaction or settlement attempt.
model Transaction {
  id        String            @id @default(uuid()) @db.Uuid
  paymentId String            @map("payment_id") @db.Uuid
  payment   Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([paymentId])
  @@map("transactions")
}

/// Chronological order status lifecycle transition history.
model OrderStatus {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatusType
  changedAt DateTime        @default(now()) @map("changed_at")

  @@index([orderId])
  @@map("order_statuses")
}
