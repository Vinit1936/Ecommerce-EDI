# ------------------------------------------------------------------------------
# NEON POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Neon Pooled Connection String (recommended for web app queries & serverless)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Neon Direct (Unpooled) Connection String (recommended for Prisma migrations)
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# NEXTAUTH / AUTHENTICATION
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="your-super-secret-random-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# FIREBASE STORAGE (Optional / Team 1 & 3)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ------------------------------------------------------------------------------
# REDIS CACHE & QUEUES (Optional / Team 2 & 3)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# PAYMENTS (Optional / Team 3)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
